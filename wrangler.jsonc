{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "terra-draw-cesium-adapter",
	"compatibility_date": "2026-08-19",
	"workers_dev": true,
	"preview_urls": true,
	// Assets-only Worker: it serves the website built by `pnpm docs:build`, which
	// bundles the API docs under /api/ and Storybook under /storybook/, so there
	// is no `main` script.
	"assets": {
		"directory": "./docs/dist"
	},
	"observability": {
		"enabled": true
	}
}
