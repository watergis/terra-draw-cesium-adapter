{
	"name": "@watergis/terra-draw-cesium-adapter",
	"version": "0.1.1",
	"description": "Terra Draw Adapter for CesiumJS",
	"source": "src/terra-draw-cesium-adapter.ts",
	"type": "module",
	"main": "./dist/terra-draw-cesium-adapter.module.js",
	"module": "./dist/terra-draw-cesium-adapter.module.js",
	"unpkg": "./dist/terra-draw-cesium-adapter.umd.js",
	"types": "./dist/terra-draw-cesium-adapter.d.ts",
	"exports": {
		".": {
			"types": "./dist/terra-draw-cesium-adapter.d.ts",
			"default": "./dist/terra-draw-cesium-adapter.modern.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "pnpm build:js && pnpm build:modern && pnpm build:types",
		"build:js": "vite build",
		"build:modern": "vite build --mode modern",
		"build:types": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"cesium": "^1.0.0",
		"terra-draw": "^1.0.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.3",
		"cesium": "1.146.0",
		"jsdom": "^30.1.2",
		"terra-draw": "1.38.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Jin Igarashi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/watergis/terra-draw-cesium-adapter.git",
		"directory": "packages/terra-draw-cesium-adapter"
	},
	"keywords": [
		"map",
		"drawing",
		"draw",
		"map drawing",
		"geometry",
		"cesium",
		"cesiumjs",
		"terra-draw"
	]
}
