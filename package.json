{
	"name": "terra-draw-cesium-adapter-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for @watergis/terra-draw-cesium-adapter - Terra Draw Adapter for CesiumJS",
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @watergis/terra-draw-cesium-adapter build",
		"test": "pnpm --filter @watergis/terra-draw-cesium-adapter test",
		"test:storybook": "pnpm --filter terra-draw-cesium-adapter-storybook test",
		"storybook": "pnpm --filter terra-draw-cesium-adapter-storybook dev",
		"storybook:build": "pnpm --filter terra-draw-cesium-adapter-storybook build",
		"docs:dev": "pnpm --filter terra-draw-cesium-adapter-docs dev",
		"docs:build": "pnpm --filter terra-draw-cesium-adapter-docs build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r typecheck",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.1",
		"lefthook": "^2.2.1",
		"prettier": "^3.9.9",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"wrangler": "^4.149.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/watergis/terra-draw-cesium-adapter.git"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"pnpm": "^12.0.0"
	}
}
