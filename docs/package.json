	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.0.0",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
